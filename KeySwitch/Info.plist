<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>SwitchBoard</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSAccessibilityUsageDescription</key>
	<string>SwitchBoard needs Accessibility access to read and transform selected text between keyboard layouts.</string>

	<!-- Sparkle 2 auto-update configuration. -->
	<!-- Points at the appcast published to the repo's `main` branch by
	     .github/workflows/release.yml (raw.githubusercontent.com serves it
	     as plain XML). Derived from this checkout's `origin` remote
	     (git@github.com:romankr-lab/KeySwitch.git) - update this if the
	     release repo ever changes. -->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/romankr-lab/KeySwitch/main/appcast.xml</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Background check interval in seconds; 86400 = once a day. Sparkle
	     also always checks once on launch regardless of this interval. -->
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!-- EdDSA public key Sparkle uses to verify downloaded update archives,
	     generated via `generate_keys` on 2026-09-16 (private key lives only
	     in this machine's login Keychain and in the SPARKLE_PRIVATE_KEY
	     GitHub Actions secret used by .github/workflows/release.yml to sign
	     each release with `sign_update`). Sparkle refuses to install any
	     update that doesn't verify against this key. -->
	<key>SUPublicEDKey</key>
	<string>uhfvAYodaFkjME3rGhb78ivErF1HNYZFZ2P8oJo5uWE=</string>
</dict>
</plist>

